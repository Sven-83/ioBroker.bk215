{
    "common": {
        "name": "bk215",
        "version": "0.2.0",
        "news": {
            "0.2.0": {
                "en": "Cloud reader: battery, solar, inverter and statistics from the SunEnergyXT cloud; local TCP and zero-feed controller removed",
                "de": "Cloud-Leser: Akku, Solar, Wechselrichter und Statistik aus der SunEnergyXT-Cloud; lokale TCP-Anbindung und Nulleinspeisungs-Regler entfernt"
            },
            "0.0.1": {
                "en": "Initial scaffolding",
                "de": "Initiales Grundgerüst"
            }
        },
        "title": "BK215 Battery Storage",
        "titleLang": {
            "en": "BK215 Battery Storage",
            "de": "BK215 Speichersystem",
            "ru": "Система хранения BK215",
            "pt": "Armazenamento BK215",
            "nl": "BK215 Opslagsysteem",
            "fr": "Stockage BK215",
            "it": "Sistema di accumulo BK215",
            "es": "Almacenamiento BK215",
            "pl": "System magazynowania BK215",
            "uk": "Система зберігання BK215",
            "zh-cn": "BK215 储能系统"
        },
        "desc": {
            "en": "Reads Sunlit / SunEnergyXT BK215 battery storage (battery, solar, inverter, energy statistics) from the SunEnergyXT cloud. Read-only, no local mode needed.",
            "de": "Liest den Sunlit- / SunEnergyXT-BK215-Speicher (Akku, Solar, Wechselrichter, Energie-Statistik) aus der SunEnergyXT-Cloud. Nur lesend, ohne Local Mode."
        },
        "authors": [
            "Sven-83 <svmorgen@gmx.de>"
        ],
        "keywords": [
            "BK215",
            "Sunlit",
            "SunEnergyXT",
            "Balkonkraftwerk",
            "Nulleinspeisung",
            "energy"
        ],
        "licenseInformation": {
            "type": "free",
            "license": "MIT"
        },
        "platform": "Javascript/Node.js",
        "main": "build/main.js",
        "icon": "bk215.png",
        "enabled": true,
        "extIcon": "https://raw.githubusercontent.com/Sven-83/sunlit/main/admin/bk215.png",
        "readme": "https://github.com/Sven-83/sunlit/blob/main/README.md",
        "loglevel": "info",
        "mode": "daemon",
        "type": "energy",
        "compact": true,
        "materialize": true,
        "connectionType": "cloud",
        "dataSource": "poll",
        "adminUI": {
            "config": "json"
        },
        "dependencies": [
            {
                "js-controller": ">=5.0.19"
            }
        ],
        "globalDependencies": [
            {
                "admin": ">=6.13.16"
            }
        ],
        "tier": 2,
        "supportedMessages": {
            "custom": false,
            "deviceManager": false
        },
        "encryptedNative": [
            "cloudPassword"
        ],
        "protectedNative": [
            "cloudPassword"
        ]
    },
    "native": {
        "cloudEmail": "",
        "cloudPassword": "",
        "familyId": 0,
        "pollLiveS": 60,
        "pollStatsMin": 15,
        "batteryCapacityKwh": 0,
        "minSoc": 10
    },
    "objects": [],
    "instanceObjects": [
        {
            "_id": "info",
            "type": "channel",
            "common": {
                "name": "Information"
            },
            "native": {}
        },
        {
            "_id": "info.connection",
            "type": "state",
            "common": {
                "role": "indicator.connected",
                "name": "Connection to BK215 established",
                "type": "boolean",
                "read": true,
                "write": false,
                "def": false
            },
            "native": {}
        }
    ]
}
